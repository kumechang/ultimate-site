---
import { SITE_TITLE, NAV_LINKS } from '../consts';
---

<header class="border-b border-slate-200 bg-white/90 backdrop-blur sticky top-0 z-50">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="text-lg font-bold text-slate-900">
      {SITE_TITLE}
    </a>
    <nav class="hidden gap-6 text-sm font-medium text-slate-700 sm:flex">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="hover:text-sky-600">{link.label}</a>
      ))}
    </nav>
    <details class="sm:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-slate-300 px-3 py-1 text-sm">
        メニュー
      </summary>
      <nav class="absolute right-4 mt-2 flex w-48 flex-col gap-1 rounded-md border border-slate-200 bg-white p-3 shadow-lg">
        {NAV_LINKS.map((link) => (
          <a href={link.href} class="rounded px-2 py-1 text-sm text-slate-700 hover:bg-slate-100">
            {link.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
