---
import { SITE_TITLE, AFFILIATE_DISCLOSURE, NAV_LINKS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-5xl px-4 py-10 text-sm text-slate-600">
    <nav class="mb-6 flex flex-wrap gap-4">
      {NAV_LINKS.map((link) => (
        <a href={link.href} class="hover:text-sky-600">{link.label}</a>
      ))}
    </nav>
    <p class="mb-4 leading-relaxed">{AFFILIATE_DISCLOSURE}</p>
    <p class="text-slate-500">&copy; {year} {SITE_TITLE}</p>
  </div>
</footer>
