---
interface Props {
  name: string;
  point: string;
  amazonUrl: string;
  imageAlt?: string;
  imageUrl?: string;
  tier?: string;
  recommended?: boolean;
}

const { name, point, amazonUrl, tier, imageAlt, imageUrl, recommended = false } = Astro.props;
// imageUrl は、AmazonアソシエイトのSiteStripe（画像リンク）で取得したURLを渡す（自サーバーには複製しない）
---

<div
  class:list={[
    'not-prose my-6 rounded-lg border p-4 shadow-sm',
    recommended ? 'border-sky-600 ring-1 ring-sky-600' : 'border-slate-200',
  ]}
>
  {tier && (
    <span
      class:list={[
        'mb-2 inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold text-white',
        recommended ? 'bg-sky-600' : 'bg-slate-900',
      ]}
    >
      {tier}
    </span>
  )}
  <div class="flex gap-4">
    {imageUrl && (
      <img
        src={imageUrl}
        alt={imageAlt ?? name}
        loading="lazy"
        width="80"
        height="80"
        class="h-20 w-20 flex-none rounded-md border border-slate-100 bg-white object-contain p-1"
        onerror="this.remove()"
      />
    )}
    <div class="min-w-0 flex-1">
      <p class="font-semibold text-slate-900">{name}</p>
      <p class="mt-1 text-sm text-slate-600">{point}</p>
      <a
        href={amazonUrl}
        target="_blank"
        rel="sponsored noopener"
        class="mt-3 inline-block rounded-md bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-sky-700"
      >
        Amazonで詳細を見る
      </a>
      <p class="mt-2 text-xs text-slate-500">価格は変動します。最新価格はAmazon商品ページでご確認ください。</p>
    </div>
  </div>
</div>
