---
interface Props {
  name: string;
  point: string;
  amazonUrl: string;
  imageAlt?: string;
  tier?: string;
}

const { name, point, amazonUrl, tier } = Astro.props;
---

<div class="not-prose my-6 rounded-lg border border-slate-200 p-4 shadow-sm">
  {tier && (
    <span class="mb-2 inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">
      {tier}
    </span>
  )}
  <p class="font-semibold text-slate-900">{name}</p>
  <p class="mt-1 text-sm text-slate-600">{point}</p>
  <a
    href={amazonUrl}
    target="_blank"
    rel="sponsored noopener"
    class="mt-3 inline-block rounded-md bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600"
  >
    Amazonで詳細を見る
  </a>
</div>
