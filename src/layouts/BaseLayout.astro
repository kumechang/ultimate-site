---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, GA_MEASUREMENT_ID } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const { title, description, image, imageWidth, imageHeight, imageAlt, noindex, type = 'website' } = Astro.props;

const siteUrl = Astro.site?.toString();

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_TITLE,
  url: siteUrl,
  // apple-touch-icon（180x180）。検索結果でのサイト名・アイコン表示の手がかりになる
  logo: new URL('/apple-touch-icon.png', Astro.site).toString(),
};

// WebSite はトップページだけに出す（サイト全体の名前の手がかり）
const websiteJsonLd =
  Astro.url.pathname === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        alternateName: 'ultimate-navi.com',
        url: siteUrl,
      }
    : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      imageAlt={imageAlt}
      noindex={noindex}
      type={type}
    />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    {websiteJsonLd && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
    {GA_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          // define:vars を付けたスクリプトは Astro が即時関数で囲むため、window に明示的に公開する。
          // （ここを関数宣言のままにすると window.gtag が未定義になり、下のクリック計測が送信されない）
          window.gtag = function gtag() { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
    <script>
      // クリック計測（GA4）。リンクに付けた data 属性を読む、共通のハンドラー。
      //   a[data-nav]           内部リンク。internal_nav（nav=「{場所}-{行き先}」、dest_path=行き先のパス）
      //   a[rel~="sponsored"]   アフィリエイトのリンク。amazon_link_click（link_url、item_name=商品名）
      //   a[data-yt-embed]      YouTube の「クリックで再生」。video_play_click（video_title）
      // 収集する項目を増やしたら、プライバシーポリシー（src/pages/privacy.astro）の表も合わせて更新する。
      // 通常の左クリックのほか、中ボタン（auxclick）も数える。ページ遷移で送信が切れないよう beacon で送る。
      type GtagWindow = Window & { gtag?: (...args: unknown[]) => void };

      function track(event: MouseEvent) {
        const gtag = (window as GtagWindow).gtag;
        if (typeof gtag !== 'function') return;
        const target = event.target;
        const el = target instanceof Element ? target : (target as Node | null)?.parentElement;
        if (!el) return;
        const send = (name: string, params: Record<string, string | undefined>) =>
          gtag('event', name, { transport_type: 'beacon', ...params });

        const nav = el.closest<HTMLAnchorElement>('a[data-nav]');
        if (nav) {
          send('internal_nav', { nav: nav.dataset.nav, dest_path: new URL(nav.href, location.href).pathname });
        }

        const aff = el.closest<HTMLAnchorElement>('a[rel~="sponsored"]');
        if (aff) {
          // 商品名は data-item を優先し、なければカード内の最初の段落（商品名）を使う。GA4 の値は100文字まで
          const item = aff.dataset.item ?? aff.parentElement?.querySelector('p')?.textContent ?? undefined;
          send('amazon_link_click', { link_url: aff.href, item_name: item?.trim().slice(0, 100) });
        }

        // YouTube は、修飾キー付きのクリック（別タブで開く操作）では再生しないので数えない
        const yt = el.closest<HTMLAnchorElement>('a[data-yt-embed]');
        if (yt && event.type === 'click' && !(event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)) {
          send('video_play_click', { video_title: yt.dataset.ytTitle });
        }
      }

      document.addEventListener('click', track);
      document.addEventListener('auxclick', (event) => {
        if (event.button === 1) track(event);
      });
    </script>
  </head>
  <body>
    <Header />
    <slot name="full-bleed" />
    <main class="mx-auto min-h-[60vh] max-w-5xl px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
