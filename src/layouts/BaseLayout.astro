---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const { title, description, image, noindex, type = 'website' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} image={image} noindex={noindex} type={type} />
  </head>
  <body>
    <Header />
    <slot name="full-bleed" />
    <main class="mx-auto min-h-[60vh] max-w-5xl px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
