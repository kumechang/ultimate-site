---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import { photoVariants } from '../lib/photoVariants';
import NextStep from '../components/NextStep.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  breadcrumb: { label: string; href: string }[];
  heroImage?: string;
  heroImageAlt?: string;
  heroImageCredit?: {
    author: string;
    license: string;
    licenseUrl?: string;
    sourceUrl: string;
    modified: boolean;
  };
  faqItems?: { question: string; answer: string }[];
  summary?: string[];
  hasAffiliateLinks?: boolean;
  nextStep?: 'full' | 'compact';
}

const { title, description, pubDate, updatedDate, breadcrumb, heroImage, heroImageAlt, heroImageCredit, faqItems, summary, hasAffiliateLinks = false, nextStep } =
  Astro.props;

const photo = await photoVariants(heroImage);

// 記事の写真は src/assets/photos に置き、astro:assets で幅別（srcset）の AVIF に変換して配信する。
// frontmatter の heroImage は従来どおり /images/photos/xxx の形で書く（ファイル名で src/assets/photos を探す）。
// src/assets/photos に無い写真（public/images/photos に残してある出所確認中のもの）は、変換せずそのまま出す。
const heroModules = import.meta.glob<ImageMetadata>('../assets/photos/*.{avif,jpg,png}', {
  eager: true,
  import: 'default',
});
const heroAsset = heroImage ? heroModules[`../assets/photos/${heroImage.split('/').pop()}`] : undefined;
const heroClass = ['not-prose aspect-video w-full rounded-lg object-cover', heroImageCredit ? 'mt-6' : 'my-6'];
const siteUrl = Astro.site?.toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE_TITLE },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).toString() },
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  // 写真のある記事は検索結果用の画像（16:9 / 4:3 / 1:1）、ない記事は og:image と同じ既定画像
  image:
    photo.urls.length > 0
      ? photo.urls.map((u) => new URL(u, Astro.site).toString())
      : [new URL('/og-default.png', Astro.site).toString()],
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: new URL(item.href, Astro.site).toString(),
  })),
};

const faqJsonLd = faqItems && faqItems.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={photo.og?.url}
  imageWidth={photo.og?.width}
  imageHeight={photo.og?.height}
  imageAlt={photo.og ? (heroImageAlt ?? title) : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <nav class="mb-6 text-sm text-slate-500" aria-label="breadcrumb">
    {breadcrumb.map((item, i) => (
      <span>
        {i > 0 && <span class="mx-1">/</span>}
        {i === breadcrumb.length - 1 ? (
          <span class="text-slate-700">{item.label}</span>
        ) : (
          <a href={item.href} class="hover:text-sky-600">{item.label}</a>
        )}
      </span>
    ))}
  </nav>

  <article class="prose-article">
    <h1>{title}</h1>
    <p class="!mt-2 text-sm text-slate-500">
      更新日: {(updatedDate ?? pubDate).toLocaleDateString('ja-JP')}
    </p>
    {hasAffiliateLinks && (
      <p class="!mt-2 text-sm font-semibold text-slate-700">本ページはアフィリエイト広告（Amazonアソシエイト）を含みます。</p>
    )}
    {summary && summary.length > 0 && (
      <div class="not-prose my-6 rounded-lg border border-slate-200 bg-slate-50 p-4">
        <p class="text-sm font-semibold text-slate-900">この記事の要点</p>
        <ul class="mt-2 space-y-1 text-sm text-slate-700">
          {summary.map((point) => (
            <li class="flex gap-2">
              <span aria-hidden="true">・</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
    {heroAsset ? (
      <Image
        src={heroAsset}
        alt={heroImageAlt ?? title}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 992px, calc(100vw - 2rem)"
        format="avif"
        quality={60}
        width={1200}
        loading="eager"
        fetchpriority="high"
        class:list={heroClass}
      />
    ) : (
      heroImage && <img src={heroImage} alt={heroImageAlt ?? title} loading="eager" class:list={heroClass} />
    )}
    {heroImage && heroImageCredit && (
      <p class="not-prose mb-6 mt-1 text-xs text-slate-500">
        写真：{heroImageCredit.author}／
        {heroImageCredit.licenseUrl ? (
          <a href={heroImageCredit.licenseUrl} target="_blank" rel="noopener license" class="underline">{heroImageCredit.license}</a>
        ) : (
          heroImageCredit.license
        )}
        （<a href={heroImageCredit.sourceUrl} target="_blank" rel="noopener" class="underline">Wikimedia Commons</a>）
        {heroImageCredit.modified && '・サイズ変更・トリミングあり'}
      </p>
    )}
    <slot />
    {nextStep && <NextStep variant={nextStep} />}
  </article>
</BaseLayout>
