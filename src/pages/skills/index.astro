---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('skills', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="アルティメットの基本技術"
  description="アルティメットの基本スロー技術を解説。最も基本のバックハンド、横から投げるフリック（サイドハンド）、頭上から投げ下ろすハンマーの特徴と使い分け、初心者向けの投げ方動画もあわせて紹介しています。"
>
  <h1 class="text-3xl font-bold text-slate-900">基本技術</h1>
  <p class="mt-3 text-slate-600">
    アルティメットの基本となるスロー技術を紹介します。観戦・プレー用語の意味を知りたい場合は
    <a href="/glossary/" class="text-sky-600 hover:underline">用語集</a>
    をご覧ください。
  </p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {entries.map((entry) => (
      <li class="relative rounded-lg border border-slate-200 p-5 hover:border-slate-900 hover:shadow-sm">
        <h2 class="section-heading font-semibold text-slate-900">
          {/* リンクの文字は見出しだけ。カード全体のクリックは after で広げる */}
          <a
            href={`/skills/${entry.id}/`}
            data-nav={`hub-skills-${entry.id}`}
            class="outline-none after:absolute after:inset-0 after:rounded-lg focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:outline-sky-600"
          >{entry.data.title}</a>
        </h2>
        <p class="mt-2 text-sm text-slate-600">{entry.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
