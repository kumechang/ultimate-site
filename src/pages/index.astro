---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    href: '/basics/',
    title: 'アルティメットとは',
    desc: '競技概要、SOTG、歴史、基本ルール、ポジション、戦術を解説します。',
  },
  {
    href: '/gear/',
    title: 'ギア選び',
    desc: 'ディスク、スパイク、グローブ、ウェアなど必須アイテムの選び方。',
  },
  {
    href: '/skills/',
    title: '技術・用語',
    desc: '3大スローの解説など、上達に役立つ基本技術を紹介します。',
  },
  {
    href: '/glossary/',
    title: '用語集',
    desc: 'ストールカウントやレイアウトなど、観戦・プレーで役立つ用語集。',
  },
  {
    href: '/start/',
    title: '始め方',
    desc: '体験できる場所、サークル・チーム・個アルの探し方。',
  },
];
const heroPhotos = [
  '/images/photos/ultimate-game-01.avif',
  '/images/photos/ultimate-game-02.avif',
  '/images/photos/ultimate-game-03.avif',
  '/images/photos/ultimate-game-04.avif',
  '/images/photos/ultimate-team-02.avif',
  '/images/photos/ultimate-action-01.avif',
  '/images/photos/disc-throw-jump.avif',
  '/images/photos/disc-closeup-02.avif',
];
---

<BaseLayout title="初心者から経験者まで使えるアルティメット総合ガイド">
  <section slot="full-bleed" class="relative overflow-hidden bg-slate-900">
    <div
      class="grid h-[520px] grid-cols-2 grid-rows-4 sm:h-[560px] sm:grid-cols-4 sm:grid-rows-2"
      aria-hidden="true"
    >
      {heroPhotos.map((src) => (
        <img src={src} alt="" loading="eager" class="h-full w-full object-cover opacity-80" />
      ))}
    </div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/70 to-slate-900/20"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center text-white">
      <h1 class="text-3xl font-extrabold drop-shadow-lg sm:text-5xl">アルティメットを、はじめよう。</h1>
      <p class="mt-4 max-w-xl text-slate-100 drop-shadow sm:text-lg">
        ルール・戦術の基礎から、初心者が揃えておきたいギアの選び方まで。初めてのアルティメットをサポートします。
      </p>
      <a
        href="/basics/what-is-ultimate/"
        class="mt-8 inline-block rounded-full bg-white px-6 py-3 font-semibold text-sky-700 hover:bg-sky-50"
      >
        アルティメットとは？を読む
      </a>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="section-heading text-2xl font-bold text-slate-900">サイトのコンテンツ</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2">
      {sections.map((s) => (
        <li class="rounded-xl border border-slate-200 p-6 hover:border-slate-900 hover:shadow-sm">
          <a href={s.href}>
            <h3 class="relative pl-4 text-lg font-semibold text-slate-900 before:absolute before:left-0 before:top-1/2 before:h-2 before:w-2 before:-translate-y-1/2 before:rounded-sm before:bg-slate-900">
              {s.title}
            </h3>
            <p class="mt-2 text-sm text-slate-600">{s.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
