---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    href: '/basics/',
    title: 'アルティメットとは',
    desc: '競技概要、SOTG、歴史、基本ルール、ポジション、戦術を解説します。',
  },
  {
    href: '/gear/',
    title: 'ギア選び',
    desc: 'ディスク、スパイク、グローブ、ウェアなど必須アイテムの選び方。',
  },
  {
    href: '/skills/',
    title: '技術・用語',
    desc: '3大スローの解説など、上達に役立つ基本技術を紹介します。',
  },
  {
    href: '/glossary/',
    title: '用語集',
    desc: 'ストールカウントやレイアウトなど、観戦・プレーで役立つ用語集。',
  },
  {
    href: '/start/',
    title: '始め方',
    desc: '体験できる場所、サークル・チーム・個アルの探し方。',
  },
];
const gamePhotos = [
  { src: '/images/photos/ultimate-game-01.avif', alt: 'アルティメットの試合中、ディスクをパスする選手' },
  { src: '/images/photos/disc-throw-jump.avif', alt: 'ジャンプしてディスクをキャッチする選手' },
  { src: '/images/photos/ultimate-team-02.avif', alt: 'チームで集まるアルティメットプレイヤーたち' },
  { src: '/images/photos/ultimate-game-03.avif', alt: 'アルティメットの試合中の攻防' },
];
---

<BaseLayout title="初心者から経験者まで使えるアルティメット総合ガイド">
  <section class="flex flex-col items-center gap-8 overflow-hidden rounded-2xl bg-gradient-to-br from-sky-500 to-lime-500 px-6 py-12 text-white sm:flex-row sm:gap-10 sm:px-16 sm:py-16">
    <div class="flex-1 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold sm:text-4xl">アルティメットを、はじめよう。</h1>
      <p class="mx-auto mt-4 max-w-xl text-sky-50 sm:mx-0">
        ルール・戦術の基礎から、初心者が揃えておきたいギアの選び方まで。初めてのアルティメットをサポートします。
      </p>
      <a
        href="/basics/what-is-ultimate/"
        class="mt-8 inline-block rounded-full bg-white px-6 py-3 font-semibold text-sky-700 hover:bg-sky-50"
      >
        アルティメットとは？を読む
      </a>
    </div>
    <div class="flex-1">
      <img
        src="/images/hero-illustration.png"
        alt="フライングディスクを投げるプレイヤーのイラスト"
        class="w-full rounded-xl"
        width="1920"
        height="1080"
      />
    </div>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-bold text-slate-900">サイトのコンテンツ</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2">
      {sections.map((s) => (
        <li class="rounded-xl border border-slate-200 p-6 hover:border-sky-300 hover:shadow-sm">
          <a href={s.href}>
            <h3 class="text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{s.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-bold text-slate-900">実際のプレーの様子</h2>
    <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      {gamePhotos.map((p) => (
        <li>
          <img
            src={p.src}
            alt={p.alt}
            loading="lazy"
            class="aspect-square w-full rounded-lg object-cover"
          />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
