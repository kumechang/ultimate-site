---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('start', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const faqItems =
  entry.id === 'faq'
    ? [
        {
          question: '運動未経験・初心者でも大丈夫？',
          answer:
            '大丈夫です。多くの大学サークルは「未経験者歓迎」を掲げており、実際に大学から初めて競技を始める人が大半です。基本ルールやスローは入部後に練習で身につけていくのが一般的なので、始める前に運動経験は必要ありません。',
        },
        {
          question: '体育会系のノリが強い部活動ですか？',
          answer:
            'サークルによります。大会出場を本格的に目指すチームから、週1回楽しく汗を流す程度のサークルまで幅広く存在します。見学・体験の際に雰囲気を確認し、自分に合った活動頻度・熱量のところを選ぶのがおすすめです。',
        },
        {
          question: '女子でも参加できますか？男女一緒にプレーするのですか？',
          answer:
            'はい、アルティメットは男女混合（ミックス）でプレーできる数少ない競技の一つです。大学サークルの多くは男女混合で活動しており、性別を問わず同じコートで一緒に楽しめるのも大きな魅力です（大会によっては男女別・混合の部門が分かれていることもあります）。',
        },
        {
          question: '練習はどれくらいの頻度でありますか？',
          answer:
            'サークルによって週1〜2回のところから、週3回以上のところまでさまざまです。大会シーズンが近づくと練習頻度が増えるサークルが多くあります。',
        },
        {
          question: '怪我のリスクはありますか？',
          answer:
            '急なダッシュや方向転換、レイアウト（体を投げ出すプレー）による突き指・捻挫が代表的な怪我です。テーピングやサポーターである程度予防できます。',
        },
        {
          question: '何から揃えればいいですか？',
          answer: 'まずはディスクと動きやすいシューズがあれば始められます。',
        },
      ]
    : undefined;
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  heroImage={entry.data.heroImage}
  heroImageAlt={entry.data.heroImageAlt}
  faqItems={faqItems}
  breadcrumb={[
    { label: 'トップ', href: '/' },
    { label: '始め方', href: '/start/' },
    { label: entry.data.title, href: `/start/${entry.id}/` },
  ]}
>
  <Content />
</ArticleLayout>
