---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { faqFromMarkdown } from '../../lib/faqFromMarkdown';

export async function getStaticPaths() {
  const entries = await getCollection('start', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// FAQPage の構造化データは、本文の「## Q. …」の見出しと回答から作る（画面の文章と常に一致させる）
const faqItems = entry.id === 'faq' ? faqFromMarkdown(entry.body) : undefined;
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  heroImage={entry.data.heroImage}
  heroImageAlt={entry.data.heroImageAlt}
  heroImageCredit={entry.data.heroImageCredit}
  summary={entry.data.summary}
  faqItems={faqItems}
  breadcrumb={[
    { label: 'トップ', href: '/' },
    { label: '始め方', href: '/start/' },
    { label: entry.data.title, href: `/start/${entry.id}/` },
  ]}
>
  <Content />
</ArticleLayout>
