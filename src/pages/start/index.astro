---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('start', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="アルティメットの始め方・コミュニティの探し方"
  description="アルティメットを体験できる場所や、大学サークル・社会人チーム、個人参加（個アル）の探し方を紹介します。"
>
  <h1 class="text-3xl font-bold text-slate-900">始め方・コミュニティ</h1>
  <p class="mt-3 text-slate-600">
    アルティメットを実際に始めたい方向けに、体験できる場所やチームの探し方を紹介します。
  </p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {entries.map((entry) => (
      <li class="rounded-lg border border-slate-200 p-5 hover:border-sky-300 hover:shadow-sm">
        <a href={`/start/${entry.id}/`} class="block">
          <h2 class="font-semibold text-slate-900">{entry.data.title}</h2>
          <p class="mt-2 text-sm text-slate-600">{entry.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
