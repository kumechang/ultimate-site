---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const terms = (await getCollection('glossary')).sort((a, b) => a.data.order - b.data.order);

const definedTermSetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'アルティメット用語集',
  url: new URL('/glossary/', Astro.site).toString(),
  hasDefinedTerm: terms.map((term) => ({
    '@type': 'DefinedTerm',
    name: term.data.term,
    description: term.data.description,
    url: new URL(`/glossary/${term.id}/`, Astro.site).toString(),
  })),
};
---

<BaseLayout
  title="アルティメット用語集"
  description="アルティメットの専門用語集。ストールカウント、レイアウト、スローオフ、ターンオーバー、ピボットなど、観戦やプレーで役立つ用語の意味を、初心者向けにわかりやすくまとめて解説します。"
>
  <script type="application/ld+json" set:html={JSON.stringify(definedTermSetJsonLd)} />
  <h1 class="text-3xl font-bold text-slate-900">アルティメット用語集</h1>
  <p class="mt-3 text-slate-600">
    観戦・プレーで役立つ専門用語をまとめました。スロー技術の練習方法を知りたい方は
    <a href="/skills/" class="text-sky-600 hover:underline">技術・用語</a>
    のページをご覧ください。
  </p>

  <p class="mt-2 text-sm text-slate-600">
    全{terms.length}語。各用語の詳しい説明と出典は、それぞれの個別ページにあります。
  </p>

  {/* 一覧は「用語名・読み・定義の1文・個別ページへのリンク」だけにする。本文は個別ページが唯一の場所（重複を避ける）。
      li の id は、#stack のようなアンカーリンクのために残す */}
  <ul class="mt-8 divide-y divide-slate-100">
    {terms.map((term) => (
      <li id={term.id} class="scroll-mt-24 py-5">
        <h2 class="text-lg font-semibold text-slate-900">
          <a href={`/glossary/${term.id}/`} data-nav={`glossary-index-${term.id}`} class="hover:text-sky-600">{term.data.term}</a>
          {term.data.reading && <span class="ml-2 text-xs font-normal text-slate-600">（{term.data.reading}）</span>}
        </h2>
        {term.data.description && <p class="mt-1 text-sm leading-relaxed text-slate-700">{term.data.description}</p>}
        <p class="mt-1 text-sm">
          <a href={`/glossary/${term.id}/`} data-nav={`glossary-index-more-${term.id}`} class="text-sky-700 underline">
            {term.data.titleTerm ?? term.data.term}の意味と使い方を読む
          </a>
        </p>
      </li>
    ))}
  </ul>
</BaseLayout>
