---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const terms = (await getCollection('glossary')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  terms.map(async (term) => ({ term, Content: (await render(term)).Content }))
);

const definedTermSetJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'アルティメット用語集',
  url: new URL('/glossary/', Astro.site).toString(),
  hasDefinedTerm: terms.map((term) => ({
    '@type': 'DefinedTerm',
    name: term.data.term,
    description: term.data.description,
    url: new URL(`/glossary/${term.id}/`, Astro.site).toString(),
  })),
};
---

<BaseLayout
  title="アルティメット用語集"
  description="ストールカウント、レイアウト、スローオフなど、アルティメットの観戦・プレーで役立つ専門用語をまとめて解説します。"
>
  <script type="application/ld+json" set:html={JSON.stringify(definedTermSetJsonLd)} />
  <h1 class="text-3xl font-bold text-slate-900">アルティメット用語集</h1>
  <p class="mt-3 text-slate-600">観戦・プレーで役立つ専門用語をまとめました。</p>

  <dl class="prose-article mt-8">
    {rendered.map(({ term, Content }) => (
      <div id={term.id} class="mb-6 scroll-mt-24 border-b border-slate-100 pb-6">
        <dt class="text-lg font-semibold text-slate-900">
          <a href={`/glossary/${term.id}/`} class="hover:text-sky-600">{term.data.term}</a>
          {term.data.reading && <span class="ml-2 text-xs font-normal text-slate-600">（{term.data.reading}）</span>}
        </dt>
        <dd class="mt-1">
          <Content />
        </dd>
      </div>
    ))}
  </dl>
</BaseLayout>
