---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('glossary');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

// 用語集の初回公開日（glossary スキーマに pubDate がないため、ここで固定する）
const GLOSSARY_PUB_DATE = new Date('2026-09-16');

const { entry } = Astro.props;
const { Content } = await render(entry);
const title = `${entry.data.titleTerm ?? entry.data.term}とは？アルティメット用語の意味を解説`;
const description =
  entry.data.description ?? `アルティメットの用語「${entry.data.term}」の意味をわかりやすく解説します。`;

const definedTermJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: entry.data.term,
  description,
  inDefinedTermSet: new URL('/glossary/', Astro.site).toString(),
  url: new URL(`/glossary/${entry.id}/`, Astro.site).toString(),
};
---

<ArticleLayout
  title={title}
  description={description}
  pubDate={GLOSSARY_PUB_DATE}
  updatedDate={entry.data.updatedDate}
  nextStep="compact"
  breadcrumb={[
    { label: 'トップ', href: '/' },
    { label: '用語集', href: '/glossary/' },
    { label: entry.data.term, href: `/glossary/${entry.id}/` },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(definedTermJsonLd)} />
  <Content />
  <p>
    他の用語もあわせて確認したい場合は<a href="/glossary/" data-nav="glossary-term-index">アルティメット用語集</a>をご覧ください。
  </p>
</ArticleLayout>
