---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('basics', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="アルティメットの基礎知識まとめ【ルール・ポジション・戦術】"
  description="アルティメットの競技概要、基本ルール、ポジション、戦術など初心者が知っておきたい基礎知識をまとめました。"
>
  <h1 class="text-3xl font-bold text-slate-900">アルティメットの基礎知識まとめ</h1>
  <p class="mt-3 text-slate-600">
    競技の概要からルール、ポジション、戦術まで、これからアルティメットを始める方向けの基礎知識をまとめています。
  </p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {entries.map((entry) => (
      <li class="relative rounded-lg border border-slate-200 p-5 hover:border-slate-900 hover:shadow-sm">
        <h2 class="section-heading font-semibold text-slate-900">
          {/* リンクの文字は見出しだけ。カード全体のクリックは after で広げる */}
          <a
            href={`/basics/${entry.id}/`}
            data-nav={`hub-basics-${entry.id}`}
            class="outline-none after:absolute after:inset-0 after:rounded-lg focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:outline-sky-600"
          >{entry.data.title}</a>
        </h2>
        <p class="mt-2 text-sm text-slate-600">{entry.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
