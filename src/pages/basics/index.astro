---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('basics', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="アルティメットの基礎知識まとめ【ルール・ポジション・戦術】"
  description="アルティメットの競技概要、基本ルール、ポジション、戦術など初心者が知っておきたい基礎知識をまとめました。"
>
  <h1 class="text-3xl font-bold text-slate-900">アルティメットの基礎知識まとめ</h1>
  <p class="mt-3 text-slate-600">
    競技の概要からルール、ポジション、戦術まで、これからアルティメットを始める方向けの基礎知識をまとめています。
  </p>

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {entries.map((entry) => (
      <li class="rounded-lg border border-slate-200 p-5 hover:border-sky-300 hover:shadow-sm">
        <a href={`/basics/${entry.id}/`} class="block">
          <h2 class="font-semibold text-slate-900">{entry.data.title}</h2>
          <p class="mt-2 text-sm text-slate-600">{entry.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
